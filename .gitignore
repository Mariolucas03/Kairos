node_modules/
build/
dist/
.DS_Store

# Variables de entorno: NINGUNA se sube.
# ⚠️ Antes solo se ignoraba ".env", así que un ".env.local" (el que se usa para
# desarrollo) se habría subido y en producción podría apuntar la app a
# localhost. Se ignoran todas las variantes.
.env
.env.*
!.env.example
/frontend/.env
/frontend/.env.*
!/frontend/.env.example

# Prototipo del handoff de diseno: solo referencia local, no se sube
/frontend/public/_proto/

# Script local para mandar notificaciones a mano (no se sube)
enviar-notificacion.ps1

# Copias de seguridad de la base de datos (pueden llevar datos de usuarios)
backups/
